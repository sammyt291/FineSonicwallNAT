<%- include('partials-head', { title }) %><body><div class="shell"><aside><a class="brand" href="/"><span class="brandmark">N</span><span>NAT<span>pilot</span></span></a><nav><a class="<%= active === 'overview' ? 'active' : '' %>" href="/">⌂ <span>Overview</span></a><% if (['admin','operator'].includes(currentUser.role)) { %><a class="<%= active === 'new' ? 'active' : '' %>" href="/forwards/new">＋ <span>New forward</span></a><% } %><% if (currentUser.role === 'admin') { %><a class="<%= active === 'admin' ? 'active' : '' %>" href="/admin">⚙ <span>Admin</span></a><% } %></nav><div class="user"><div class="avatar"><%= currentUser.username[0].toUpperCase() %></div><div><b><%= currentUser.username %></b><small><%= currentUser.role %></small></div><form method="post" action="/logout"><button title="Sign out">↪</button></form></div></aside><main><% if (message) { %><div class="flash <%= message.type %>"><%= message.text %></div><% } %>
