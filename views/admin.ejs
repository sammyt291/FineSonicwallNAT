<%- include('partials-shell-start', { title: 'Admin', active: 'admin' }) %><header><div><p class="eyebrow">ADMINISTRATION</p><h1>Settings & access</h1><p class="muted">Connect appliances and control who can change network policy.</p></div></header><div class="admin-grid"><section class="panel"><div class="panel-head"><div><h2>Firewalls</h2><p class="muted">SonicOS API connections</p></div></div><div class="list"><% firewalls.forEach((fw) => { %><div class="list-row"><span class="device">▣</span><div><b><%= fw.name %></b><small><%= fw.host %></small></div><form method="post" action="/admin/firewalls/<%= fw.id %>/test"><button class="pill" title="Test SonicOS API"><%= fw.lastTestResult || 'Test API' %></button></form></div><% }) %><% if (!firewalls.length) { %><p class="muted">No firewalls configured.</p><% } %></div><form method="post" action="/admin/firewalls" class="stack inset"><h3>Add SonicWall</h3><label>Display name<input name="name" required placeholder="HQ · TZ 580"></label><label>Management URL<input name="host" required placeholder="https://192.168.1.1"></label><div class="grid"><label>API username<input name="username" required></label><label>API password<input name="password" type="password" required></label></div><label class="check"><input type="checkbox" name="verifyTls" checked> Verify TLS certificate</label><button class="primary">Add firewall</button></form></section><section class="panel"><div class="panel-head"><div><h2>Team access</h2><p class="muted">Local accounts and permissions</p></div></div><div class="list"><% users.forEach((user) => { %><div class="list-row"><div class="avatar"><%= user.username[0].toUpperCase() %></div><div><b><%= user.username %> <% if (user.permanentAdmin) { %><em>Owner</em><% } %></b><small><%= user.role %></small></div><% if (!user.permanentAdmin) { %><form method="post" action="/admin/users/<%= user.id %>/role"><select name="role" onchange="this.form.submit()"><% ['viewer','operator','admin'].forEach((role) => { %><option <%= role === user.role ? 'selected' : '' %>><%= role %></option><% }) %></select></form><% } %></div><% }) %></div><form method="post" action="/admin/users" class="stack inset"><h3>Create account</h3><label>Username<input name="username" required></label><label>Temporary password<input name="password" type="password" minlength="10" required></label><label>Permission<select name="role"><option value="viewer">Viewer · read only</option><option value="operator">Operator · manage rules</option><option value="admin">Admin · full access</option></select></label><button class="primary">Create account</button></form></section></div><%- include('partials-shell-end') %>
