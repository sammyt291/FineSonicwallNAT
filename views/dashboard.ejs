<%- include('partials-shell-start', { title: 'Overview', active: 'overview' }) %>
<header><div><p class="eyebrow">NETWORK OPERATIONS</p><h1>Port forward overview</h1><p class="muted">See every exposed service across your SonicWall fleet.</p></div><% if (['admin','operator'].includes(currentUser.role)) { %><a class="button primary" href="/forwards/new">＋ New port forward</a><% } %></header>
<section class="stats"><article><span>↗</span><div><small>TOTAL FORWARDS</small><strong><%= stats.total %></strong></div></article><article><span class="green">●</span><div><small>ACTIVE RULES</small><strong><%= stats.active %></strong></div></article><article><span>▣</span><div><small>FIREWALLS</small><strong><%= stats.firewalls %></strong></div></article><article><span>⌾</span><div><small>SOURCE RESTRICTED</small><strong><%= stats.restricted %></strong></div></article></section>
<section class="panel"><div class="panel-head"><div><h2>Published services</h2><p class="muted">Inbound traffic and its internal destination</p></div><input class="search" placeholder="Search rules…" oninput="document.querySelectorAll('tbody tr').forEach(r=>r.hidden=!r.innerText.toLowerCase().includes(this.value.toLowerCase()))"></div>
<% if (forwards.length) { %><div class="table-wrap"><table><thead><tr><th>NAME</th><th>PUBLIC ENDPOINT</th><th></th><th>INTERNAL DESTINATION</th><th>SOURCE</th><th>FIREWALL</th><th>STATUS</th><th></th></tr></thead><tbody><% forwards.forEach((rule) => { %><tr><td><b><%= rule.name %></b><small><%= rule.protocol %></small></td><td><code><%= rule.externalIp %>:<%= rule.sourcePort %></code></td><td class="arrow">→</td><td><code><%= rule.internalIp %>:<%= rule.destinationPort %></code></td><td><%= rule.sourceIps %></td><td><%= rule.firewallName %></td><td><span class="pill <%= rule.status === 'deployed' ? 'on' : '' %>" title="<%= rule.deploymentError || '' %>"><%= rule.status %></span></td><td class="actions"><% if (['admin','operator'].includes(currentUser.role)) { %><form method="post" action="/forwards/<%= rule.id %>/deploy"><button title="Deploy to SonicWall">↑</button></form><form method="post" action="/forwards/<%= rule.id %>/toggle"><button title="Toggle local state">◐</button></form><% } %><% if (currentUser.role === 'admin') { %><form method="post" action="/forwards/<%= rule.id %>/delete" onsubmit="return confirm('Remove this rule?')"><button title="Delete">×</button></form><% } %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty"><div>↗</div><h3>No port forwards yet</h3><p>Add a firewall in Admin, then publish your first internal service.</p></div><% } %></section>
<%- include('partials-shell-end') %>
